# Docker's --env-file takes EVERYTHING after '=' as the value, including what
# looks like a trailing comment. Keep every comment on its own line.

# --- market ---
LOBF_SYMBOL=btcusdt
LOBF_DEPTH_INTERVAL=100ms

# --- storage ---
LOBF_DATA_ROOT=/data
LOBF_ROTATE_SECONDS=3600
# flush interval bounds worst-case loss on SIGKILL
LOBF_FLUSH_SECONDS=5

# --- resilience ---
# lower to 50000 on a box with under 2GB RAM
LOBF_QUEUE_MAXSIZE=200000
# data-plane idle timer: catches a socket that is open but silent
LOBF_STALE_TIMEOUT_S=20
LOBF_SNAPSHOT_INTERVAL_S=1800
# caps REST bursts when gaps cluster during volatility
LOBF_GAP_SNAPSHOT_COOLDOWN_S=5
# recycle before Binance's 24h forced close
LOBF_CONN_MAX_AGE_S=72000

# --- subscription integrity ---
# A stream that delivers nothing has no gap, no error and no stall to detect.
LOBF_SUBSCRIPTION_TIMEOUT_S=30
# 1 for the soak run; set 0 once proven
LOBF_FAIL_ON_MISSING_STREAM=1

# --- observability ---
LOBF_METRICS_INTERVAL_S=60
LOBF_LOG_LEVEL=INFO
